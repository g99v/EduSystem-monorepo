###############################################################################
# EduSystem API collection  --  VS Code "REST Client" (humao.rest-client)
#
# Click "Send Request" above a request, or run
#   "REST Client: Run All Requests in Current File"
# to execute top-to-bottom. Named requests feed later ones, so running the whole
# file in order is the intended flow.
#
# HOW TO RUN
#   .\mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=dev"
#   The dev profile seeds an ADMIN account: admin@example.com / password123
#   (see DevAdminSeeder). Instructors can only log in -- they are created by an admin.
#
# AUTH MODEL (why each section has two CSRF calls)
#   Session cookies + CSRF, not JWTs:
#     1. GET /api/auth/csrf   -> creates a session and returns a token
#     2. POST /api/auth/login -> needs that token, then ROTATES the session id
#                                AND the CSRF token
#     3. GET /api/auth/csrf   -> fetch the NEW token for later writes
#   Unsafe methods (POST/PUT/PATCH/DELETE) need "X-CSRF-TOKEN"; GET needs nothing.
#   A stale token gives 403, which looks identical to a role failure.
#
# !! SESSION SHARING -- the cookie jar holds ONE session !!
#   Logging in as another role REPLACES the previous session for every later
#   request. Run sections in order, and if you jump backwards, re-run that
#   section's login. Each section starts with its own CSRF + login pair.
###############################################################################

@baseUrl = http://localhost:8080
@json = application/json

@adminEmail = admin@example.com
@adminPassword = password123

@instructorEmail = instructor1@example.com
@instructorPassword = password123

@studentEmail = student1@example.com
@studentPassword = password123

# POST /api/schools returns only the name and the student DTOs omit ids, so this
# one has to be read from the database:
#   SELECT id FROM school ORDER BY id DESC LIMIT 1;
@schoolId = 1


###############################################################################
# 1. ADMIN: LOG IN
###############################################################################

### 1a. First CSRF token (also starts the session)
# @name csrfAdmin
GET {{baseUrl}}/api/auth/csrf


### 1b. Log in as ADMIN
# @name loginAdmin
POST {{baseUrl}}/api/auth/login
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfAdmin.response.body.$.token}}

{
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
}


### 1c. New CSRF token (required after any login)
# @name csrfAdminAfterLogin
GET {{baseUrl}}/api/auth/csrf


### 1d. Session check -> { "role": "ADMIN", "studentId": null, "instructorId": null }
GET {{baseUrl}}/api/auth/me


###############################################################################
# 2. ADMIN: SET UP AN INSTRUCTOR AND A COURSE THEY OWN
#
# Course ownership is what lets an instructor manage a course. Only admins set it.
###############################################################################

### 2a. Create the instructor account (+ instructor profile)
# @name createInstructor
POST {{baseUrl}}/api/instructors
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfAdminAfterLogin.response.body.$.token}}

{
    "firstName": "Ada",
    "lastName": "Lovelace",
    "email": "{{instructorEmail}}",
    "password": "{{instructorPassword}}"
}


### 2b. List instructors -> find the id to use as instructorId below
GET {{baseUrl}}/api/instructors


### 2c. Create a course and assign its owning instructor
# @name createCourse
POST {{baseUrl}}/api/courses
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfAdminAfterLogin.response.body.$.token}}

{
    "name": "Introduction to Computer Science",
    "description": "CS101 - fundamentals of programming.",
    "teacherName": "Ada Lovelace",
    "instructorId": {{createInstructor.response.body.$.id}}
}


### 2d. Optional: a school to attach students to
POST {{baseUrl}}/api/schools
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfAdminAfterLogin.response.body.$.token}}

{
    "name": "Springfield High"
}


###############################################################################
# 3. STUDENT: REGISTER, BROWSE, SELF-ENROLL, READ, SUBMIT
#
# The student id comes from the session, so a student can only enroll themselves.
###############################################################################

### 3a. Register (public; still needs a CSRF token from a fresh session)
# @name csrfAnonymous
GET {{baseUrl}}/api/auth/csrf


### 3b. Register a student
# @name registerStudent
POST {{baseUrl}}/api/auth/register/student
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfAnonymous.response.body.$.token}}

{
    "firstName": "Jane",
    "lastName": "Doe",
    "email": "{{studentEmail}}",
    "password": "{{studentPassword}}",
    "age": 21,
    "schoolId": {{schoolId}}
}


### 3c. CSRF + log in as the student (this replaces the admin session)
# @name csrfStudent
GET {{baseUrl}}/api/auth/csrf


### 3d. Log in as the student
# @name loginStudent
POST {{baseUrl}}/api/auth/login
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfStudent.response.body.$.token}}

{
    "email": "{{studentEmail}}",
    "password": "{{studentPassword}}"
}


### 3e. New CSRF token for the student session
# @name csrfStudentAfterLogin
GET {{baseUrl}}/api/auth/csrf


### 3f. Session check -> studentId is NOT the same as id
GET {{baseUrl}}/api/auth/me


### 3g. Browse the catalogue of available courses
GET {{baseUrl}}/api/courses


### 3h. My courses -> empty until enrolled
# @name myCoursesBefore
GET {{baseUrl}}/api/me/courses


### 3i. Self-enroll in a course
# 201 on success, 409 if already enrolled.
POST {{baseUrl}}/api/courses/{{courseId}}/enrollments
X-CSRF-TOKEN: {{csrfStudentAfterLogin.response.body.$.token}}


### 3j. My courses -> now contains it
GET {{baseUrl}}/api/me/courses


### 3k. Lectures for an enrolled course (403 if not enrolled)
GET {{baseUrl}}/api/courses/{{courseId}}/lectures


### 3l. Download a lecture
GET {{baseUrl}}/api/lectures/{{lectureId}}/content


### 3m. Assignments for an enrolled course (403 if not enrolled)
GET {{baseUrl}}/api/courses/{{courseId}}/assignments


### 3n. Download the assignment brief
GET {{baseUrl}}/api/assignments/{{assignmentId}}/file


### 3o. Submit a solution (re-submission is allowed - each upload is a new row)
# @name submitSolution
POST {{baseUrl}}/api/assignments/{{assignmentId}}/submissions
Content-Type: multipart/form-data; boundary=----EduBoundary
X-CSRF-TOKEN: {{csrfStudentAfterLogin.response.body.$.token}}

------EduBoundary
Content-Disposition: form-data; name="file"; filename="solution.pdf"
Content-Type: application/pdf

< ./samples/sample.pdf
------EduBoundary--


### 3p. My submissions for that assignment, newest first (shows the grade)
GET {{baseUrl}}/api/assignments/{{assignmentId}}/submissions/me


### 3q. Withdraw my own submission (allowed unless it has been graded by an admin)
DELETE {{baseUrl}}/api/submissions/{{submitSolution.response.body.$.id}}
X-CSRF-TOKEN: {{csrfStudentAfterLogin.response.body.$.token}}


###############################################################################
# 4. INSTRUCTOR: MANAGE OWNED COURSES AND GRADE
#
# Every write below is scoped to a course the instructor owns; a course with no
# owner can only be managed by an admin.
###############################################################################

### 4a. CSRF + log in as the instructor
# @name csrfInstructor
GET {{baseUrl}}/api/auth/csrf


### 4b. Log in as the instructor
# @name loginInstructor
POST {{baseUrl}}/api/auth/login
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfInstructor.response.body.$.token}}

{
    "email": "{{instructorEmail}}",
    "password": "{{instructorPassword}}"
}


### 4c. New CSRF token for the instructor session
# @name csrfInstructorAfterLogin
GET {{baseUrl}}/api/auth/csrf


### 4d. Session check -> instructorId is populated
GET {{baseUrl}}/api/auth/me


### 4e. My courses -> only the courses this instructor owns
GET {{baseUrl}}/api/me/courses


### 4f. Upload a lecture
# @name createLecture
POST {{baseUrl}}/api/courses/{{courseId}}/lectures
Content-Type: multipart/form-data; boundary=----EduBoundary
X-CSRF-TOKEN: {{csrfInstructorAfterLogin.response.body.$.token}}

------EduBoundary
Content-Disposition: form-data; name="title"

Big-O notation
------EduBoundary
Content-Disposition: form-data; name="displayOrder"

1
------EduBoundary
Content-Disposition: form-data; name="file"; filename="sample.pdf"
Content-Type: application/pdf

< ./samples/sample.pdf
------EduBoundary--


### 4g. Update a lecture (no file change)
PUT {{baseUrl}}/api/lectures/{{createLecture.response.body.$.id}}
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfInstructorAfterLogin.response.body.$.token}}

{
    "title": "Big-O notation (revised)",
    "displayOrder": 1
}


### 4h. Upload an assignment
# @name createAssignment
POST {{baseUrl}}/api/courses/{{courseId}}/assignments
Content-Type: multipart/form-data; boundary=----EduBoundary
X-CSRF-TOKEN: {{csrfInstructorAfterLogin.response.body.$.token}}

------EduBoundary
Content-Disposition: form-data; name="title"

Binary search trees
------EduBoundary
Content-Disposition: form-data; name="assignmentInstructions"

Implement insert, delete and in-order traversal. Submit a single PDF.
------EduBoundary
Content-Disposition: form-data; name="maxGrade"

25
------EduBoundary
Content-Disposition: form-data; name="displayOrder"

1
------EduBoundary
Content-Disposition: form-data; name="file"; filename="sample.pdf"
Content-Type: application/pdf

< ./samples/sample.pdf
------EduBoundary--


### 4i. Update an assignment (title / instructions / maximum grade)
PUT {{baseUrl}}/api/assignments/{{createAssignment.response.body.$.id}}
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfInstructorAfterLogin.response.body.$.token}}

{
    "title": "Binary search trees (revised)",
    "assignmentInstructions": "Also submit a complexity analysis.",
    "maxGrade": 25,
    "displayOrder": 1
}


### 4j. All solutions handed in for the assignment
GET {{baseUrl}}/api/assignments/{{assignmentId}}/submissions


### 4k. Download a solution
GET {{baseUrl}}/api/submissions/{{submitSolution.response.body.$.id}}/file


### 4l. Grade a solution
# 400 if the grade exceeds the assignment's maxGrade.
PUT {{baseUrl}}/api/submissions/{{submitSolution.response.body.$.id}}
Content-Type: {{json}}
X-CSRF-TOKEN: {{csrfInstructorAfterLogin.response.body.$.token}}

{
    "grade": 22,
    "feedback": "Correct, but the delete case leaks a reference."
}


### 4m. Delete an assignment (submissions must be removed first)
DELETE {{baseUrl}}/api/assignments/{{createAssignment.response.body.$.id}}
X-CSRF-TOKEN: {{csrfInstructorAfterLogin.response.body.$.token}}


###############################################################################
# 5. SIGN OUT
###############################################################################

### 5a. Logout -> 204
POST {{baseUrl}}/api/auth/logout
X-CSRF-TOKEN: {{csrfInstructorAfterLogin.response.body.$.token}}
